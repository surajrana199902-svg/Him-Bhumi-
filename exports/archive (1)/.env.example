# Copy this file to .env and fill in your own values
MONGO_URL=mongodb://localhost:27017
DB_NAME=himbhumi
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# Emergent Universal LLM key (AI Concierge). Or use your own OPENAI_API_KEY.
EMERGENT_LLM_KEY=
OPENAI_MODEL=gpt-4o

# Email OTP via SMTP (Brevo relay example)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HimBhumi Real Estates <no-reply@yourdomain.com>

# Optional cloud media storage (Cloudinary unsigned upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
